# Copy to .env.local for local development, or set in Vercel → Project → Settings → Environment Variables.

# Required in production (≥ 32 characters)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Phase 5 — Resend (password-reset email). When missing, demo shows the reset link on screen.
RESEND_API_KEY=
EMAIL_FROM=CvSU Events <onboarding@resend.dev>

# Phase 5 — MongoDB Atlas (durable data on Vercel). Lab/default still uses /data JSON when unset.
MONGODB_URI=
MONGODB_DB=cvsu_events
