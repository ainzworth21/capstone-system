# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Local stakeholder notes; keep these out of the published repository
/client-request.txt
/implementation-plan.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Runtime JSON database. Contains accounts, password hashes, tokens,
# participant PII, attendance, test responses, and issued-certificate records.
/data/*.json
!/data/.gitkeep

# User-uploaded or identity-related files
/public/uploads/
/public/certificates/cert_*
/public/speaker-ids/id_*
/public/pubmats/pubmat_*

# Local backups may contain copies of the JSON database and environment files
/backup/**
!/backup/README.md

# Local system backups (keep backup/README.md)
/backup/snapshots/
/backup/versions/
/backup/LATEST.txt
